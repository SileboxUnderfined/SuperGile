{
  "name": "supergile",
  "version": "0.1.1",
  "private": true,
  "description": "YouGile issue provider plugin for Super Productivity",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "api-key": "node scripts/get-api-key.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
